{
  "name": "node-red-to-project",
  "version": "0.1.0",
  "description": "Convert a Node-RED flows.json export into a standalone, code-first Node.js project",
  "bin": {
    "node-red-to-project": "bin/cli.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "web": "node bin/cli.js --serve",
    "test:integration": "node --test test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@node-red/nodes": "^5.0.4",
    "@node-red/util": "^5.0.4",
    "express": "^4.22.2"
  }
}
